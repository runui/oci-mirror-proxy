{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "oci-mirror-proxy remote mirror catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "regions", "mirrors"],
  "properties": {
    "version": {"const": 1},
    "regions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,31}$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "mirrors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "regions", "endpoints"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "website": {"type": "string", "format": "uri", "pattern": "^https?://"},
          "regions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "endpoints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["registry", "url"],
              "properties": {
                "registry": {"type": "string", "minLength": 1},
                "url": {"type": "string", "format": "uri", "pattern": "^https?://"}
              }
            }
          }
        }
      }
    }
  }
}
